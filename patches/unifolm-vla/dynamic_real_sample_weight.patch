+def _g1_plush_real_weight() -> float:
+    """Read a bounded real-data sampling weight for controlled campaigns."""
+    value = float(os.environ.get("G1_PLUSH_REAL_WEIGHT", "3.0"))
+    if not math.isfinite(value) or not 1.0 <= value <= 12.0:
+        raise ValueError(
+            "G1_PLUSH_REAL_WEIGHT must be finite and between 1.0 and 12.0"
+        )
+    return value
