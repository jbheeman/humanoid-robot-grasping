diff --git a/src/unifolm_vla/model/modules/action_model/DiT_ActionHeader.py b/src/unifolm_vla/model/modules/action_model/DiT_ActionHeader.py
index 0c5218b..2c41ab3 100644
--- a/src/unifolm_vla/model/modules/action_model/DiT_ActionHeader.py
+++ b/src/unifolm_vla/model/modules/action_model/DiT_ActionHeader.py
@@ -231,3 +231,26 @@ class FlowmatchingActionHead(nn.Module):
         # Slice out only the action portion of pred and target.
-        loss = ((pred_actions - velocity) ** 2).mean()
+        squared_error = (pred_actions - velocity) ** 2
+        configured_weights = self.config.get("loss_dimension_weights")
+        if configured_weights is None:
+            loss = squared_error.mean()
+        else:
+            weights = torch.as_tensor(
+                configured_weights,
+                dtype=squared_error.dtype,
+                device=squared_error.device,
+            )
+            if weights.shape != (self.action_dim,):
+                raise ValueError(
+                    "action_model.loss_dimension_weights must contain "
+                    f"{self.action_dim} values, received {tuple(weights.shape)}"
+                )
+            if (
+                not torch.isfinite(weights).all()
+                or torch.any(weights < 0)
+                or weights.sum() <= 0
+            ):
+                raise ValueError("action loss weights must be finite, non-negative, and nonzero")
+            loss = (squared_error * weights).sum() / (
+                squared_error.shape[0] * squared_error.shape[1] * weights.sum()
+            )
         return loss
