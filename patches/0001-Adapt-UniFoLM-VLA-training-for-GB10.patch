+@functools.lru_cache(maxsize=4)
+def _load_video_pyav(video_path: str) -> tuple[np.ndarray, np.ndarray]:
+    """Decode one episode camera once; torchvision's VideoReader is absent on ARM64."""
+    frames: list[np.ndarray] = []
+    timestamps: list[float] = []
+    with av.open(video_path) as container:
+        stream = container.streams.video[0]
+        fps = float(stream.average_rate) if stream.average_rate else 30.0
+        for index, frame in enumerate(container.decode(stream)):
+            frames.append(frame.to_ndarray(format="rgb24"))
+            timestamps.append(float(frame.time) if frame.time is not None else index / fps)
+    if not frames:
+        raise RuntimeError(f"No video frames decoded from {video_path}")
+    return np.stack(frames), np.asarray(timestamps, dtype=np.float64)
+
+
+def _decode_video_frames_pyav(video_path, timestamps, tolerance_s, backend=None) -> torch.Tensor:
+    """LeRobot-compatible PyAV decoder without torchvision's removed VideoReader API."""
+    frames, frame_timestamps = _load_video_pyav(str(video_path))
+    query_timestamps = np.asarray(timestamps, dtype=np.float64)
+    nearest = np.abs(frame_timestamps[:, None] - query_timestamps[None, :]).argmin(axis=0)
+    distances = np.abs(frame_timestamps[nearest] - query_timestamps)
+    if np.any(distances >= tolerance_s):
+        raise RuntimeError(
+            f"Video timestamp mismatch for {video_path}: max error {distances.max():.4f}s "
+            f">= tolerance {tolerance_s:.4f}s"
+        )
+    return torch.from_numpy(frames[nearest]).permute(0, 3, 1, 2).float().div_(255)
+
