#usda 1.0
(
    defaultPrim = "Bunny"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bunny" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    kind = "component"
)
{
    float physics:mass = 0.15
    rel material:binding:physics = </Bunny/PhysicsMaterial>

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.10
        float physics:restitution = 0.02
        float physics:staticFriction = 0.12
    }

    def Scope "Looks"
    {
        def Material "Fur"
        {
            token outputs:surface.connect = </Bunny/Looks/Fur/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.50, 0.42, 0.32)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }
        def Material "LightFur"
        {
            token outputs:surface.connect = </Bunny/Looks/LightFur/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.53, 0.41)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.94
                token outputs:surface
            }
        }
        def Material "InnerEar"
        {
            token outputs:surface.connect = </Bunny/Looks/InnerEar/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.61, 0.43, 0.39)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }
        def Material "Eye"
        {
            token outputs:surface.connect = </Bunny/Looks/Eye/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.009, 0.008)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.20
                token outputs:surface
            }
        }
    }

    def Xform "Collision"
    {
        def Cylinder "WeightedBase" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.0575
            double height = 0.024
            double3 xformOp:translate = (-0.008, 0, 0.012)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            token visibility = "invisible"
        }
        def Capsule "Torso" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.052
            double height = 0.036
            double3 xformOp:translate = (-0.006, 0, 0.073)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            token visibility = "invisible"
        }
        def Sphere "Head" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            double radius = 0.0425
            double3 xformOp:translate = (0.025, 0, 0.142)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            token visibility = "invisible"
        }
        def Capsule "LeftEar" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.016
            double height = 0.040
            double3 xformOp:rotateXYZ = (0, -10, 0)
            double3 xformOp:translate = (0.010, 0.023, 0.198)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            token visibility = "invisible"
        }
        def Capsule "RightEar" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.016
            double height = 0.040
            double3 xformOp:rotateXYZ = (12, -62, 0)
            double3 xformOp:translate = (-0.003, -0.025, 0.171)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            token visibility = "invisible"
        }
    }

    def Xform "Visual"
    {
        def Sphere "Body" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/Fur>
            double radius = 1
            float3 xformOp:scale = (0.065, 0.058, 0.0675)
            double3 xformOp:translate = (-0.018, 0, 0.068)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "Chest" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/LightFur>
            double radius = 1
            float3 xformOp:scale = (0.046, 0.050, 0.058)
            double3 xformOp:translate = (0.018, 0, 0.092)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "Head" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/LightFur>
            double radius = 1
            float3 xformOp:scale = (0.0425, 0.0425, 0.040)
            double3 xformOp:translate = (0.025, 0, 0.142)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "Muzzle" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/LightFur>
            double radius = 1
            float3 xformOp:scale = (0.025, 0.030, 0.021)
            double3 xformOp:translate = (0.052, 0, 0.132)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Capsule "LeftEar" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.016
            double height = 0.040
            rel material:binding = </Bunny/Looks/Fur>
            double3 xformOp:rotateXYZ = (0, -10, 0)
            double3 xformOp:translate = (0.010, 0.023, 0.198)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Capsule "RightEar" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.016
            double height = 0.040
            rel material:binding = </Bunny/Looks/Fur>
            double3 xformOp:rotateXYZ = (12, -62, 0)
            double3 xformOp:translate = (-0.003, -0.025, 0.171)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Capsule "LeftInnerEar" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.0075
            double height = 0.038
            rel material:binding = </Bunny/Looks/InnerEar>
            double3 xformOp:rotateXYZ = (0, -10, 0)
            double3 xformOp:translate = (0.013, 0.037, 0.198)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Capsule "RightInnerEar" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            uniform token axis = "Z"
            double radius = 0.0075
            double height = 0.035
            rel material:binding = </Bunny/Looks/InnerEar>
            double3 xformOp:rotateXYZ = (12, -62, 0)
            double3 xformOp:translate = (0.005, -0.036, 0.171)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Sphere "Tail" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/LightFur>
            double radius = 0.029
            double3 xformOp:translate = (-0.064, 0, 0.064)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Sphere "LeftHindFoot" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/Fur>
            double radius = 1
            float3 xformOp:scale = (0.042, 0.023, 0.018)
            double3 xformOp:translate = (-0.025, 0.044, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "RightHindFoot" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/Fur>
            double radius = 1
            float3 xformOp:scale = (0.042, 0.023, 0.018)
            double3 xformOp:translate = (-0.025, -0.044, 0.024)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "LeftFrontPaw" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/LightFur>
            double radius = 1
            float3 xformOp:scale = (0.032, 0.016, 0.014)
            double3 xformOp:translate = (0.042, 0.025, 0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "RightFrontPaw" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/LightFur>
            double radius = 1
            float3 xformOp:scale = (0.032, 0.016, 0.014)
            double3 xformOp:translate = (0.042, -0.025, 0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "LeftEye" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/Eye>
            double radius = 0.006
            float3 xformOp:scale = (0.85, 1.0, 1.0)
            double3 xformOp:translate = (0.052, 0.034, 0.153)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "RightEye" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/Eye>
            double radius = 0.006
            float3 xformOp:scale = (0.85, 1.0, 1.0)
            double3 xformOp:translate = (0.052, -0.034, 0.153)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            # The real head-camera views expose the near eye only. Hiding the
            # far primitive also avoids its projection outside the proxy when
            # the object is viewed almost exactly side-on.
            token visibility = "invisible"
        }
        def Sphere "Nose" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </Bunny/Looks/Eye>
            double radius = 0.0045
            double3 xformOp:translate = (0.077, 0, 0.142)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
